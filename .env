# Configuración de Base de Datos MySQL
# Conectar a MySQL en XAMPP (localhost:3306)
# Base de datos: sistema_tickets_v2

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=zoe

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=zoe-desarrollo-cambiar-en-produccion

# Notas:
# - Asegurar que MySQL esté corriendo en XAMPP
# - La BD "sistema_tickets_v2" debe existir en phpMyAdmin
# - Usuario root sin contraseña (configuración por defecto de XAMPP)