# Configuración de Base de Datos
# Conectar a MySQL en XAMPP (localhost:3306)
# Base de datos: zoe (debe existir en phpMyAdmin)
# Usuario: root
# Contraseña: (vacía por defecto en XAMPP)

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=zoe

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=zoe-desarrollo-cambiar-en-produccion

# Notas:
# - Si XAMPP le pidió contraseña durante instalación, actualizar DB_PASSWORD
# - Asegurar que MySQL esté corriendo: Services > MySQL o XAMPP Control Panel
# - La BD "zoe" debe existir pero puede estar vacía (se crearán tablas automáticamente)
